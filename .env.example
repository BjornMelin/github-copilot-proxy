VISION_BACKEND_BASE_URL=
VISION_BACKEND_API_KEY=
VISION_BACKEND_DEFAULT_MODEL=gpt-4o
VISION_BACKEND_MODELS=

# Rate Limiting
# Requests per minute for default endpoints
RATE_LIMIT_DEFAULT=60
# Requests per minute for chat completions
RATE_LIMIT_CHAT_COMPLETIONS=20

# Logging
LOG_LEVEL=info
