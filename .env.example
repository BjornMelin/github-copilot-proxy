# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development

# GitHub Copilot Configuration
GITHUB_COPILOT_CLIENT_ID=Iv1.b507a08c87ecfe98
COPILOT_DEFAULT_MODEL=gpt-4.1
COPILOT_MODELS=gpt-4.1,gpt-4.1-mini,gpt-4o,gpt-4o-mini,gpt-4-turbo,gpt-4,gpt-3.5-turbo

# Optional Vision Backend Configuration
# Set these to route image inputs and vision-model requests to an OpenAI-compatible multimodal backend.
